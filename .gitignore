# Godot 4 caches. The import cache lives in .godot/ and is regenerated on open.
#
# NOT ignored, on purpose: *.gd.uid and *.import. Since Godot 4.4 these carry the
# stable resource UIDs that scenes and preloads resolve against; leaving them out
# makes every fresh clone mint new ones.
godot/.godot/
godot/android/
*.translation

# NOT ignored, on purpose: godot/export_presets.cfg. Godot ignores it by default
# because it can carry signing secrets; this one carries none, and it is the
# build configuration the Pages workflow needs to produce the same web build
# locally and in CI.

# Build output
build/
export/
dist/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Simulation output (regenerated by tools/run_sims.sh)
out/
*.save.json.local

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
