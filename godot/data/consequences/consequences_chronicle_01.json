        {
          "type": "SET_GLOBAL_TAG",
          "target": {
            "kind": "world",
            "id": "WORLD"
          },
          "payload": {
            "tag": "mine_sealed"
          }
        },
        {
          "type": "SET_ENTITY_TAG",
          "target": {
            "kind": "entity",
            "id": "$proponent"
          },
          "payload": {
            "tag": "discovery:crystal"
          }
        }
      ]
    },
    {
      "id": "CNS_COST_UNREST",
      "title": "Il Prezzo del Consenso",
      "category": "REVOLT",
      "description": "La proposta passa, ma qualcuno la paga senza averla votata. Le strade di Eredan si riempiono di gente che aspetta.",
      "effects": [
        {
          "type": "SET_REGION_TAG",
          "target": {
            "kind": "region",
            "id": "REG_EREDAN"
          },
          "payload": {
            "tag": "condition:unrest"
          }
        },
        {
          "type": "ADJUST_TENSION",
          "target": {
            "kind": "tension",
            "id": "$tension"
          },
          "payload": {
            "delta": 1
          }
        }
      ]
    },
    {
      "id": "CNS_FAILURE_SPIRAL",
      "title": "Nessuno Decide",
      "category": "DEVASTATION",
      "description": "La proposta cade. La questione resta esattamente dov'era, con meno tempo davanti e piu rancore intorno.",
      "effects": [
        {
          "type": "SET_GLOBAL_TAG",
          "target": {
            "kind": "world",
            "id": "WORLD"
          },
          "payload": {
            "tag": "question_unresolved"
          }
        },
        {
          "type": "SET_ENTITY_TAG",
          "target": {
            "kind": "entity",
            "id": "$proponent"
          },
          "payload": {
            "tag": "failed_proposal"
          }
        }
      ]
    },
    {
      "id": "CNS_DECISIVE_RENOWN",
      "title": "Ordine Ristabilito",
      "category": "INFLUENCE",
      "description": "La proposta non passa soltanto: convince. Per un tempo, il tavolo smette di discutere chi ha ragione.",
      "effects": [
        {
          "type": "SET_ENTITY_TAG",
          "target": {
            "kind": "entity",
            "id": "$proponent"
          },
          "payload": {
            "tag": "renowned"
          }
        },
        {
          "type": "SET_GLOBAL_TAG",
          "target": {
            "kind": "world",
            "id": "WORLD"
          },
          "payload": {
            "tag": "order_restored"
          }
        }
      ]
    },
    {
      "id": "CNS_VALLEY_CLEARED",
      "title": "La Valle Sgomberata",
      "category": "MIGRATION",
      "description": "Requisire il grano vuol dire decidere chi sta sulla terra che lo produce. I carri che erano fermi nella Valle vengono rimessi in strada.",
      "effects": [
        {
          "type": "REMOVE_PRESENCE",
          "target": {
            "kind": "entity",
            "id": "ENT_NAHR"
          },
          "payload": {
            "region_id": "REG_VALLE_VERDE",
            "optional": true
          },
          "note": "optional: la Valle puo essere gia sgombera."
        },
        {
          "type": "SET_REGION_TAG",
          "target": {
            "kind": "region",
            "id": "REG_VALLE_VERDE"
          },
          "payload": {
            "tag": "condition:requisitioned"
          }
        }
      ]
    },
    {
      "id": "CNS_CROWN_DISPOSSESSED",
      "title": "Il Titolo che non Vale piu",
      "category": "CONTROL",
      "description": "Se la terra e di chi la lavora, il sigillo di Eredan sulla Valle diventa una riga su una pergamena e nient'altro.",
