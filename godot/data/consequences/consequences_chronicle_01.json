        },
        {
          "type": "SET_GLOBAL_TAG",
          "target": {
            "kind": "world",
            "id": "WORLD"
          },
          "payload": {
            "tag": "crown_dispossessed"
          }
        }
      ]
    },
    {
      "id": "CNS_MINE_TAKEN",
      "title": "La Miniera di Stato",
      "category": "EXPLOITATION",
      "description": "Aprire le gallerie significa metterci qualcuno a contare quello che esce. Chi conta, comanda.",
      "effects": [
        {
          "type": "SET_CONTROL",
          "target": {
            "kind": "region",
            "id": "REG_MINIERE_ANTICHE"
          },
          "payload": {
            "entity_id": "$proponent"
          }
        }
      ]
    },
    {
      "id": "CNS_STUDY_UNDER_GUARD",
      "title": "Studio sotto Custodia",
      "category": "DISCOVERY",
      "description": "Il Cristallo si puo misurare, ma davanti a un custode e con un limite scritto. Nessuno lo porta fuori, e nessuno smette di guardarlo.",
