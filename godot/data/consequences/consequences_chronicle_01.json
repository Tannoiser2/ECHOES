{
  "schema_id": "consequence",
  "version": "0.2.0",
  "items": [
    {
      "id": "CNS_ROYAL_GRANARY",
      "title": "Il Granaio del Trono",
      "category": "PROSPERITY",
      "description": "Il grano della Valle passa dalle mani del trono prima di arrivare a una tavola. Chi lo distribuisce decide chi mangia.",
      "effects": [
        {
          "type": "SET_REGION_TAG",
          "target": {
            "kind": "region",
            "id": "$region_with:granary"
          },
          "payload": {
            "tag": "structure:granary"
          }
        },
        {
          "type": "ADJUST_TENSION",
          "target": {
            "kind": "tension",
            "id": "TEN_ROADS"
          },
          "payload": {
            "delta": 1
          },
          "note": "Il grano requisito viaggia sotto scorta, e le vie si intasano di carri del trono: la domanda più votata della saga adesso tocca anche chi vive di strade (D-070)."
        },
        {
          "type": "SET_CONTROL",
          "target": {
            "kind": "region",
            "id": "$region_focus"
          },
          "payload": {
            "entity_id": "$proponent"
          }
        },
        {
          "type": "SET_GLOBAL_TAG",
          "target": {
            "kind": "world",
            "id": "WORLD"
          },
          "payload": {
            "tag": "grain_requisitioned"
          }
        }
      ]
    },
    {
      "id": "CNS_NAHR_SETTLEMENT",
      "title": "Chi Lavora Mangia",
      "category": "SETTLEMENT",
      "description": "La Valle si apre a chi arriva da est. Il confine non viene abolito: viene spostato dentro le persone.",
      "effects": [
        {
          "type": "SET_REGION_TAG",
          "target": {
            "kind": "region",
            "id": "$region_focus"
          },
          "payload": {
            "tag": "settlement:$proponent"
          }
        },
        {
          "type": "SET_GLOBAL_TAG",
          "target": {
            "kind": "world",
            "id": "WORLD"
          },
          "payload": {
            "tag": "nahr_settled"
          }
        },
        {
          "type": "SET_RELATION",
          "target": {
            "kind": "relation",
            "id": "$proponent|$rival"
          },
          "payload": {
            "add_tag": "PACT"
          }
        }
      ]
    },
    {
      "id": "CNS_SEALED_VALLEY",
      "title": "La Valle Chiusa",
      "category": "CONTROL",
      "description": "I confini si chiudono. La Valle nutre Eredan e nessun altro, e le Terre Nahr imparano cosa significa un inverno senza uscita.",
      "creates_scar": true,
      "scar": {
        "region_id": "$region_focus",
        "tag": "scar:sealed_border",
        "description": "Il vallo di pietra a secco tirato su in un inverno: nessuno lo ha più smontato."
      },
      "effects": [
        {
          "type": "SET_CONTROL",
          "target": {
            "kind": "region",
            "id": "$region_focus"
          },
          "payload": {
            "entity_id": "$proponent"
          }
        },
        {
          "type": "SET_GLOBAL_TAG",
          "target": {
            "kind": "world",
            "id": "$adjacent"
          },
          "payload": {
            "tag": "valley_sealed"
          }
        },
        {
          "type": "SET_REGION_TAG",
          "target": {
            "kind": "region",
            "id": "$rival_seat"
          },
          "payload": {
            "tag": "condition:starving"
          }
        },
        {
          "type": "REMOVE_PRESENCE",
          "target": {
            "kind": "entity",
            "id": "$rival"
          },
          "payload": {
            "region_id": "REG_TERRE_NAHR",
            "optional": true
          },
          "note": "Un inverno senza uscita non si aspetta sul posto: chi può andarsene se ne va. Regione nominata, non $region_focus, perché e quella che il Minimo del popolo nomina (AUDIT_DESTINI 7.2); optional copre il rivale che li non sta."
        },
        {
          "type": "SET_RELATION",
          "target": {
            "kind": "relation",
            "id": "$proponent|$rival"
          },
          "payload": {
            "level": "ENEMY"
          }
        }
      ]
    },
    {
