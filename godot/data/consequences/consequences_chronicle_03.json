    {
      "id": "CNS_CANALS_DUG",
      "title": "I Canali Riaperti",
      "category": "PROSPERITY",
      "description": "Si scava per due stagioni, e il fiume ricomincia ad arrivare dove arrivava prima. La parte difficile non era scavare: era decidere chi mandava gli uomini.",
      "effects": [
        {
          "type": "SET_GLOBAL_TAG",
          "target": {
            "kind": "world",
            "id": "WORLD"
          },
          "payload": {
            "tag": "water_moves"
          }
        },
        {
          "type": "BUILD_STRUCTURE",
          "target": {
            "kind": "region",
            "id": "$region_with:granary"
          },
          "payload": {
            "structure_type": "STR_CANAL",
            "grade": 1,
            "owner": "$proponent"
          },
          "note": "L'opera come oggetto (D-162): ha un padrone, entra nel conto del controllo, puo' diventare una grande opera e puo' cadere."
        },
        {
          "type": "ADJUST_TENSION",
          "target": {
            "kind": "tension",
            "id": "TEN_WATER"
          },
          "payload": {
            "delta": -2
          }
        }
      ]
    },
