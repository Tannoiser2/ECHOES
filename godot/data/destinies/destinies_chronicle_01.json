    {
      "id": "DST_ALDRIC",
      "entity_id": "ENT_ALDRIC",
      "title": "Il Regno che Resta",
      "description": "Tenere Eredan indipendente e raggiungere un controllo politico sufficiente, senza lasciare il regno in collasso.",
      "minimum": {
        "label": "Il trono regge",
        "conditions": [
          {
            "type": "entity_alive",
            "entity_id": "ENT_ALDRIC",
            "label": "Aldric e ancora sul trono"
          },
          {
            "type": "region_presence",
            "entity_id": "ENT_ALDRIC",
            "region_id": "REG_EREDAN",
            "min": 1,
            "label": "Presenza a Eredan"
          }
        ]
      },
      "victory": {
        "label": "Il regno decide",
        "conditions": [
          {
            "type": "control_count",
            "entity_id": "ENT_ALDRIC",
            "min": 2,
            "label": "Controllo di almeno 2 Regioni"
          },
          {
            "type": "tension_limit",
            "tension_id": "TEN_FAMINE",
            "max": 4,
            "label": "La Carestia non supera 4"
          }
        ]
      },
      "triumph": {
        "label": "Un regno che non ha pagato il pane con il sangue",
        "conditions": [
          {
            "type": "state_tag_absent",
            "scope": "REGION",
            "region_id": "REG_EREDAN",
            "tag": "condition:unrest",
            "label": "Eredan non e in rivolta"
          },
          {
            "type": "state_tag_absent",
            "scope": "GLOBAL",
            "tag": "question_unresolved",
            "label": "Nessuna questione lasciata aperta"
          },
          {
            "type": "state_tag_absent",
            "scope": "GLOBAL",
            "tag": "crown_divided",
            "label": "La corona non e stata spezzata"
          },
          {
            "type": "tension_limit",
            "tension_id": "TEN_SUCCESSION",
            "max": 4,
            "label": "E nessuno ha ancora chiesto chi siede dopo"
          }
        ]
      },
      "art_prompt_key": "destiny.aldric"
    },
