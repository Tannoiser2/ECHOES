      "triumph": {
        "label": "E cosa ci sia dentro lo sa, e le gallerie sono ancora sue",
        "conditions": [
          {
            "type": "state_tag_present",
            "scope": "ENTITY",
            "entity_id": "ENT_VETRO",
            "tag": "discovery:relic",
            "label": "L'Ordine ha messo a verbale cosa custodisce"
          },
          {
            "type": "state_tag_absent",
            "scope": "REGION",
            "region_id": "REG_MINIERE_ANTICHE",
