  "items": [
    {
      "id": "DST_SALE",
      "entity_id": "ENT_SALE",
      "title": "Il Registro che Tiene",
      "description": "La Gilda non vuole comandare: vuole che quello che e scritto continui a valere, e che a scriverlo sia lei.",
      "art_prompt_key": "destiny.sale",
      "minimum": {
        "label": "La Gilda e ancora al tavolo",
        "conditions": [
          {
            "type": "entity_alive",
            "entity_id": "ENT_SALE",
            "label": "La Gilda esiste ancora"
          },
          {
            "type": "region_presence",
            "entity_id": "ENT_SALE",
            "region_id": "REG_STRADA_MERCANTI",
            "min": 1,
            "label": "Presenza sulla Strada dei Mercanti"
          }
        ]
      },
      "victory": {
        "label": "Il debito e stato chiamato, e nessuno lo ha cancellato",
        "conditions": [
          {
            "type": "state_tag_present",
            "scope": "GLOBAL",
            "tag": "debt_called",
            "label": "Il debito e stato chiamato per intero"
          },
          {
            "type": "state_tag_absent",
            "scope": "GLOBAL",
            "tag": "debt_forgiven",
            "label": "E nessuno lo ha cancellato"
          }
        ]
      },
      "triumph": {
        "label": "E la firma vale ancora",
        "conditions": [
          {
            "type": "promise_kept",
            "entity_id": "ENT_SALE",
            "other_entity_id": "ENT_CENERE",
            "label": "Il patto con i Signori della Cenere regge"
          },
          {
            "type": "state_tag_absent",
            "scope": "GLOBAL",
            "tag": "ledger_public",
            "label": "E il registro resta suo"
          },
          {
            "type": "control_count",
            "entity_id": "ENT_SALE",
            "min": 2,
            "label": "E il registro copre due Regioni, non una"
          },
          {
            "type": "tension_limit",
            "tension_id": "TEN_DEBT",
            "max": 5,
            "label": "E il Debito non ha spaccato la Strada"
          }
        ]
      }
    },
    {
      "id": "DST_SALE_OPEN",
      "entity_id": "ENT_SALE",
      "title": "Il Registro Aperto",
      "description": "Una Gilda che ha gia vinto una volta scopre che la firma tiene finche qualcuno si fida. Adesso vuole essere creduta, non solo dovuta.",
      "art_prompt_key": "destiny.sale.open",
      "minimum": {
        "label": "La Gilda esiste ancora",
        "conditions": [
          {
            "type": "entity_alive",
            "entity_id": "ENT_SALE",
            "label": "La Gilda esiste ancora"
          }
        ]
      },
      "victory": {
        "label": "E il registro si puo leggere",
        "conditions": [
          {
            "type": "state_tag_present",
            "scope": "GLOBAL",
            "tag": "ledger_public",
            "label": "Il registro e stato aperto"
          },
          {
            "type": "control_count",
            "entity_id": "ENT_SALE",
            "min": 1,
            "label": "Almeno una Regione controllata"
          }
        ]
      },
      "triumph": {
        "label": "E vale lo stesso",
        "conditions": [
          {
            "type": "state_tag_present",
            "scope": "GLOBAL",
            "tag": "water_moves",
            "label": "L'acqua torna a muoversi, e i lavori li ha pagati lei"
          },
          {
            "type": "region_presence",
            "entity_id": "ENT_SALE",
            "region_id": "REG_STRADA_MERCANTI",
            "min": 1,
            "label": "Presenza sulla Strada dei Mercanti"
          },
          {
            "type": "state_tag_present",
            "scope": "ENTITY",
            "entity_id": "ENT_SALE",
            "tag": "discovery:legend",
            "label": "E la vecchia pagina e stata riletta e trascritta nel registro"
          }
        ]
      }
    },
    {
      "id": "DST_VETRO",
      "entity_id": "ENT_VETRO",
