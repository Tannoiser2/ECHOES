    {
      "id": "DST_SALE",
      "entity_id": "ENT_SALE",
      "title": "Il Registro che Tiene",
      "description": "La Gilda non vuole comandare: vuole che quello che è scritto continui a valere, e che a scriverlo sia lei.",
      "art_prompt_key": "destiny.sale",
      "minimum": {
        "label": "La Gilda è ancora al tavolo",
        "conditions": [
          {
            "type": "entity_alive",
            "entity_id": "ENT_SALE",
            "label": "La Gilda esiste ancora"
          },
          {
            "type": "region_presence",
            "entity_id": "ENT_SALE",
            "region_id": "REG_STRADA_MERCANTI",
            "min": 1,
            "label": "Presenza sulla Strada dei Mercanti"
          }
        ]
      },
      "victory": {
        "label": "Il debito è stato chiamato, e nessuno lo ha cancellato",
        "conditions": [
          {
            "type": "state_tag_present",
            "scope": "GLOBAL",
            "tag": "debt_called",
            "label": "Il debito è stato chiamato per intero"
          },
          {
            "type": "relation_state",
            "entity_id": "ENT_SALE",
            "other_entity_id": "ENT_CENERE",
            "level": "NEUTRAL",
            "at_least": true,
            "label": "E chi lo doveva non le è diventato nemico"
          }
        ]
      },
      "triumph": {
        "label": "E la firma vale ancora",
        "conditions": [
          {
            "type": "state_tag_absent",
            "scope": "GLOBAL",
            "tag": "ledger_public",
            "label": "Il registro non è finito sul muro: è ancora suo"
          },
          {
            "type": "some_of",
            "min": 4,
            "label": "E quattro segni che il registro pesa più della spada",
            "conditions": [
              {
                "type": "promise_kept",
                "entity_id": "ENT_SALE",
                "other_entity_id": "ENT_CENERE",
                "label": "Il patto con i Signori della Cenere regge"
              },
              {
                "type": "tension_limit",
                "tension_id": "TEN_DEBT",
                "max": 5,
                "label": "E il Debito non ha spaccato la Strada"
              },
              {
                "type": "structure_count",
                "entity_id": "ENT_SALE",
                "min": 2,
                "label": "Il registro ha più di una casa"
              },
              {
                "type": "scar_count",
                "region_id": "REG_STRADA_MERCANTI",
                "max": 0,
                "label": "La Strada dei Mercanti è uscita pulita"
              },
              {
                "type": "structure_count",
                "entity_id": "ENT_SALE",
                "structure_type": "STR_TOLLGATE",
                "min": 2,
                "label": "E ci sono due cose murate che portano il suo nome"
              }
            ]
          }
        ]
      }
    },
    {
