{
  "schema_id": "destiny",
  "version": "0.2.0",
  "items": [
    {
      "id": "DST_SHARED_RENOWN",
      "entity_id": "$self",
      "title": "Il Nome che Pesa",
      "description": "Non importa da dove vieni: importa che quando parli, il tavolo ascolta. La stessa ambizione per chiunque la giuri - la fama, e un posto da cui difenderla.",
      "minimum": {
        "label": "La casa è ancora al tavolo",
        "conditions": [
          {
            "type": "entity_alive",
            "entity_id": "$self",
            "label": "La casa esiste ancora"
          }
        ]
      },
      "victory": {
        "label": "Il nome è conosciuto",
        "conditions": [
          {
            "type": "state_tag_present",
            "scope": "ENTITY",
            "entity_id": "$self",
            "tag": "renowned",
            "label": "La casa porta il segno della fama"
          }
        ]
      },
      "triumph": {
        "label": "Un nome che nessuno ha visto fallire",
        "conditions": [
          {
            "type": "state_tag_absent",
            "scope": "ENTITY",
            "entity_id": "$self",
            "tag": "failed_proposal",
            "label": "Nessuna proposta caduta a verbale"
          },
          {
            "type": "some_of",
            "min": 3,
            "label": "E tre segni che il nome ha un peso",
            "conditions": [
              {
                "type": "control_count",
                "entity_id": "$self",
                "min": 2,
                "label": "Controllo di almeno 2 Regioni"
              },
              {
                "type": "structure_count",
                "entity_id": "$self",
                "min": 1,
                "label": "Qualcosa di suo che sta in piedi"
              },
              {
                "type": "structure_count",
                "entity_id": "$self",
                "structure_family": "OPERA",
                "min": 1,
                "label": "Un'opera che porta il suo nome"
              },
              {
                "type": "scar_count",
                "max": 2,
                "label": "E l'anno non ha lasciato più di due segni sul mondo"
              }
            ]
          }
        ]
      },
      "art_prompt_key": "destiny.shared.renown"
    },
    {
      "id": "DST_SHARED_LAND",
      "entity_id": "$self",
      "title": "La Terra che Risponde",
      "description": "Chiunque tu sia, la domanda è la stessa: quanta terra risponde quando chiami? Un'ambizione semplice e spietata - contare le Regioni, e contarle tue.",
      "minimum": {
        "label": "Un posto che risponde",
        "conditions": [
          {
            "type": "control_count",
            "entity_id": "$self",
            "min": 1,
            "label": "Almeno una Regione controllata"
          }
        ]
      },
      "victory": {
        "label": "La terra risponde, e non importa come",
        "conditions": [
          {
            "type": "some_of",
            "min": 1,
            "label": "Due Regioni che rispondono, o due cose che stanno in piedi",
            "conditions": [
              {
                "type": "control_count",
                "entity_id": "$self",
                "min": 2,
                "label": "Controllo di almeno 2 Regioni"
              },
              {
                "type": "structure_count",
                "entity_id": "$self",
                "min": 2,
                "label": "O due strutture sue"
              }
            ]
          }
        ]
      },
      "triumph": {
        "label": "La mappa parla la tua lingua",
        "conditions": [
          {
            "type": "control_count",
            "entity_id": "$self",
            "min": 3,
            "label": "Controllo di almeno 3 Regioni"
          }
        ]
      },
      "art_prompt_key": "destiny.shared.land"
    },
    {
      "id": "DST_SHARED_ACCOUNTS",
      "entity_id": "$self",
      "title": "I Conti Chiusi",
      "description": "Vincere non è prendere: è una firma che vale, e finire la cronaca senza debiti a verbale. Nessuna proposta caduta, nessuna domanda lasciata aperta, nessun giuramento spezzato nel mondo che lasci.",
      "minimum": {
        "label": "La casa è ancora al tavolo",
        "conditions": [
          {
            "type": "entity_alive",
            "entity_id": "$self",
            "label": "La casa esiste ancora"
          }
        ]
      },
      "victory": {
        "label": "Nessuna domanda lasciata aperta",
        "conditions": [
          {
            "type": "state_tag_absent",
            "scope": "GLOBAL",
            "tag": "question_unresolved",
            "label": "Nessuna questione lasciata aperta"
          }
        ]
      },
      "triumph": {
        "label": "Un mondo che non deve niente a nessuno",
        "conditions": [
          {
            "type": "state_tag_absent",
            "scope": "GLOBAL",
            "tag": "oath_broken",
            "label": "Nessun giuramento spezzato è rimasto scritto"
          },
          {
            "type": "some_of",
            "min": 3,
            "label": "E tre segni che i conti li ha chiusi lei",
            "conditions": [
              {
                "type": "state_tag_present",
                "scope": "ENTITY",
                "entity_id": "$self",
                "tag": "renowned",
                "label": "La casa porta il segno della fama"
              },
              {
                "type": "structure_count",
                "entity_id": "$self",
                "min": 1,
                "label": "Qualcosa di suo che sta in piedi"
              },
              {
                "type": "scar_count",
                "max": 2,
                "label": "L'anno non ha lasciato più di due segni sul mondo"
              },
              {
                "type": "control_count",
                "entity_id": "$self",
                "min": 1,
                "label": "E un posto che risponde a lei"
              }
            ]
          }
        ]
      },
      "art_prompt_key": "destiny.shared.accounts"
    }
  ]
}
