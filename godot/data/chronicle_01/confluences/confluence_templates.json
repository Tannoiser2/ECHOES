{
  "schema_id": "confluence_template",
  "version": "0.2.0",
  "items": [
    {
      "id": "CNF_FAMINE_01",
      "tension_id": "TEN_FAMINE",
      "title": "Il Consiglio del Grano",
      "description": "Quando la Carestia raggiunge la soglia, la questione non e piu se ci sia abbastanza: e chi decide a chi non ne tocca.",
      "questions": [
        {
          "id": "Q_FAMINE_GRAIN",
          "text": "Chi nutre $the_region quando i granai si svuotano?",
          "eligibility": []
        },
        {
          "id": "Q_FAMINE_LAND",
          "text": "$in_region, a chi appartiene la terra che ancora produce?",
          "eligibility": [
            {
              "type": "tension_limit",
              "tension_id": "TEN_FAMINE",
              "min": 6,
              "label": "La Carestia e al limite"
            }
          ]
        }
      ],
      "propositions": [
        {
          "id": "P_REQUISITION",
          "question_id": "Q_FAMINE_GRAIN",
          "text": "Il grano $of_region e requisito e distribuito dal trono, razione per razione.",
          "eligibility": [
            {
              "type": "state_tag_present",
              "scope": "ENTITY",
              "entity_id": "$proponent",
              "tag": "crowned",
              "label": "Solo chi porta la corona puo requisire"
            }
          ],
          "success_consequences": [
            "CNS_ROYAL_GRANARY",
            "CNS_VALLEY_CLEARED"
          ],
          "echo_summary": "Il grano $of_region passo sotto il sigillo di $proponent."
        },
        {
          "id": "P_OPEN_VALLEY",
          "question_id": "Q_FAMINE_GRAIN",
          "text": "$proponent apre $the_region a chi arriva da est: chi lavora la terra ne mangia.",
          "eligibility": [],
          "success_consequences": [
            "CNS_NAHR_SETTLEMENT",
            "CNS_CROWN_DISPOSSESSED"
          ],
          "echo_summary": "$proponent entro $in_region, e quella terra smise di essere solo di $controller."
        },
        {
          "id": "P_SEAL_BORDERS",
          "question_id": "Q_FAMINE_LAND",
          "text": "I confini si chiudono: quello che cresce $in_region resta a $proponent, e a nessun altro.",
          "eligibility": [
            {
              "type": "state_tag_present",
              "scope": "ENTITY",
              "entity_id": "$proponent",
              "tag": "crowned",
              "label": "Solo il trono puo chiudere i confini del regno"
            }
          ],
          "success_consequences": [
            "CNS_SEALED_VALLEY"
          ],
          "echo_summary": "I confini $of_region furono chiusi, e l'inverno resto fuori con $rival."
        },
        {
          "id": "P_LAND_TO_WORKERS",
          "question_id": "Q_FAMINE_LAND",
          "text": "La terra $of_region appartiene a chi la lavora, e quest'anno la lavora chi e arrivato.",
          "eligibility": [],
          "success_consequences": [
            "CNS_NAHR_SETTLEMENT",
            "CNS_CROWN_DISPOSSESSED"
          ],
          "echo_summary": "La terra $of_region fu assegnata a chi la lavorava, e il titolo di chi la teneva resto scritto solo sulla carta."
        }
      ],
      "condition_clauses": [
        {
          "id": "C_FAMINE_SHARE",
          "text": "...purche una quota fissa resti a $rival.",
          "effects": [
            {
              "type": "REMOVE_REGION_TAG",
              "target": {
                "kind": "region",
                "id": "REG_TERRE_NAHR"
              },
              "payload": {
                "tag": "condition:starving"
              }
            },
            {
              "type": "SET_GLOBAL_TAG",
              "target": {
                "kind": "world",
                "id": "WORLD"
              },
              "payload": {
                "tag": "quota_guaranteed"
              }
            }
          ]
        },
        {
          "id": "C_FAMINE_AUDIT",
          "text": "...purche la distribuzione $in_region sia contata davanti a testimoni.",
          "effects": [
            {
              "type": "SET_GLOBAL_TAG",
              "target": {
                "kind": "world",
                "id": "WORLD"
              },
              "payload": {
                "tag": "distribution_audited"
              }
            },
            {
              "type": "ADJUST_TENSION",
              "target": {
                "kind": "tension",
                "id": "TEN_FAMINE"
              },
              "payload": {
                "delta": -1
              }
            }
          ]
        }
      ],
      "consequence_pools": {
        "cost": [
          "CNS_COST_UNREST"
        ],
        "failure": [
          "CNS_FAILURE_SPIRAL"
        ],
        "decisive_bonus": [
          "CNS_DECISIVE_RENOWN"
        ]
      },
      "ripple": {
        "targets": [
          "TEN_AWAKENING"
        ],
        "delta": 1
      },
      "echo_title_template": "Il Consiglio del Grano"
    },
    {
      "id": "CNF_AWAKENING_01",
      "tension_id": "TEN_AWAKENING",
      "title": "Cio che Dorme sotto la Pietra",
      "description": "Il Cristallo Rosso non e piu una curiosita. Qualcuno deve dire, ad alta voce, cosa se ne fa.",
      "questions": [
        {
          "id": "Q_AWAKENING_CRYSTAL",
          "text": "Che cosa si fa del Cristallo Rosso che esce $in_region?",
          "eligibility": []
        },
        {
          "id": "Q_AWAKENING_MOUNTAIN",
          "text": "A chi appartiene cio che dorme sotto $the_region?",
          "eligibility": [
            {
              "type": "tension_limit",
              "tension_id": "TEN_AWAKENING",
              "min": 6,
              "label": "Il Risveglio e vicino"
            }
          ]
        }
      ],
      "propositions": [
        {
          "id": "P_EXPLOIT",
          "question_id": "Q_AWAKENING_CRYSTAL",
          "text": "Si scava $in_region. Il Cristallo diventa ricchezza, e la ricchezza diventa grano.",
          "eligibility": [],
          "success_consequences": [
            "CNS_CRYSTAL_EXPLOITED",
            "CNS_MINE_TAKEN"
          ],
          "echo_summary": "Si scavo $in_region, e il Cristallo Rosso usci alla luce a peso."
        },
        {
          "id": "P_SEAL_MINE",
          "question_id": "Q_AWAKENING_CRYSTAL",
          "text": "Le gallerie $in_region si sigillano. Cio che dorme resta addormentato.",
          "eligibility": [],
          "success_consequences": [
            "CNS_MINE_SEALED"
          ],
          "echo_summary": "Le gallerie $in_region furono sigillate, e la domanda con loro."
        },
        {
          "id": "P_GUARDED_STUDY",
          "question_id": "Q_AWAKENING_MOUNTAIN",
          "text": "Il Cristallo si studia sotto vincolo, e a rispondere del limite e $rival.",
          "eligibility": [],
          "success_consequences": [
            "CNS_STUDY_UNDER_GUARD"
          ],
          "echo_summary": "Il Cristallo Rosso fu affidato a $rival, e lo studio ebbe un limite scritto."
        }
      ],
      "condition_clauses": [
        {
          "id": "C_AWAKENING_WITNESS",
          "text": "...purche $rival assista a ogni discesa.",
          "effects": [
            {
              "type": "SET_GLOBAL_TAG",
              "target": {
                "kind": "world",
                "id": "WORLD"
              },
              "payload": {
                "tag": "descent_witnessed"
              }
            },
            {
              "type": "ADJUST_TENSION",
              "target": {
                "kind": "tension",
                "id": "TEN_AWAKENING"
              },
              "payload": {
                "delta": -1
              }
            }
          ]
        },
        {
          "id": "C_AWAKENING_SHARE",
          "text": "...purche cio che si scopre sia detto a tutti, non a chi paga.",
          "effects": [
            {
              "type": "SET_GLOBAL_TAG",
              "target": {
                "kind": "world",
                "id": "WORLD"
              },
              "payload": {
                "tag": "knowledge_shared"
              }
            },
            {
              "type": "SET_ENTITY_TAG",
              "target": {
                "kind": "entity",
                "id": "ENT_LYRA"
              },
              "payload": {
                "tag": "discovery:shared_record"
              }
            }
          ]
        }
      ],
      "consequence_pools": {
        "cost": [
          "CNS_COST_UNREST"
        ],
        "failure": [
          "CNS_FAILURE_SPIRAL"
        ],
        "decisive_bonus": [
          "CNS_DECISIVE_RENOWN"
        ]
      },
      "ripple": {
        "targets": [
          "TEN_FAMINE"
        ],
        "delta": 1
      },
      "echo_title_template": "Cio che Dorme sotto la Pietra"
    }
  ]
}
