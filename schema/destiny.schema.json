{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echoes.local/schema/destiny.schema.json",
  "title": "Destiny collection",
  "x-echoes-def": "destiny",
  "x-echoes-kind": "collection",
  "type": "object",
  "required": [
    "schema_id",
    "version",
    "items"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_id": {
      "const": "destiny"
    },
    "version": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/destiny"
      }
    }
  },
  "$defs": {
    "condition": {
      "type": "object",
      "description": "Reusable WorldState predicate (§14). Evaluated by DestinyEvaluator / ConditionEvaluator.",
      "required": [
        "type"
      ],
      "additionalProperties": false,
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "control_count",
            "state_tag_present",
            "state_tag_absent",
            "asset_threshold",
            "entity_alive",
            "relation_state",
            "tension_limit",
            "discovery_count",
            "region_presence",
            "promise_kept",
            "promise_broken",
            "structure_count",
            "scar_count",
            "any_of",
            "some_of"
          ]
        },
        "entity_id": {
          "type": "string"
        },
        "other_entity_id": {
          "type": "string"
        },
        "region_id": {
          "type": "string"
        },
        "tension_id": {
          "type": "string"
        },
        "family": {
          "type": "string",
          "enum": [
            "FORCE",
            "AUTHORITY",
            "PEOPLE",
            "KNOWLEDGE",
            "WEALTH",
            "BONDS"
          ]
        },
        "tag": {
          "type": "string"
        },
        "scope": {
          "type": "string",
          "enum": [
            "GLOBAL",
            "REGION",
            "ENTITY"
          ]
        },
        "min": {
          "type": "integer"
        },
        "max": {
          "type": "integer"
        },
        "level": {
          "type": "string",
          "enum": [
            "ENEMY",
            "HOSTILE",
            "NEUTRAL",
            "ALLY",
            "BOUND"
          ]
        },
        "at_least": {
          "type": "boolean",
          "default": true,
          "description": "relation_state: true = level or better; false = exactly this level."
        },
        "label": {
          "type": "string"
        },
        "structure_type": {
          "type": "string",
          "description": "Per `structure_count`: quale tipo del catalogo. Omesso, vale qualunque tipo."
        },
        "structure_family": {
          "type": "string",
          "enum": ["PRESIDIO", "INSEDIAMENTO", "OPERA", "LUOGO", "CHIUSURA"],
          "description": "Per `structure_count`: limita il conto a una famiglia — «due presidi» invece di «due strutture qualsiasi». Omessa, contano tutte."
        },
        "grade": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4,
          "description": "Il grado **minimo** che la struttura deve avere. Un Destino che chiede una reggia chiede grado 3; uno che chiede «qualcosa di murato» chiede grado 1."
        },
        "anyone": {
          "type": "boolean",
          "default": false,
          "description": "Per `structure_count`: se contino anche le strutture di un altro. Serve alle clausole scritte sul mondo invece che sulla propria casa — «e nessuno ha alzato una reggia sulla montagna» e' `anyone` con `max: 0`."
        },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "description": "Per `any_of`: vale quando almeno una vale. Per `some_of`: quando ne valgono almeno `min`. Ogni altra lista di condizioni nello schema e' una AND.",
          "items": {
            "$ref": "#/$defs/condition"
          }
        }
      }
    },
    "destiny": {
      "type": "object",
      "required": [
        "id",
        "entity_id",
        "title",
        "description",
        "minimum",
        "victory",
        "triumph"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^DST_[A-Z0-9_]+$"
        },
        "entity_id": {
          "type": "string",
          "pattern": "^(ENT_[A-Z0-9_]+|\\$self)$",
          "description": "Il seggio a cui questo Destino appartiene - o \"$self\" per un Destino condivisibile (voce 20, D-115): la stessa carta in più pool, le clausole risolte su chi la giura."
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "minimum": {
          "$ref": "#/$defs/level"
        },
        "victory": {
          "$ref": "#/$defs/level"
        },
        "triumph": {
          "$ref": "#/$defs/level"
        },
        "art_prompt_key": {
          "type": "string"
        }
      }
    },
    "level": {
      "type": "object",
      "required": [
        "label",
        "conditions"
      ],
      "additionalProperties": false,
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/condition"
          }
        }
      }
    }
  }
}
