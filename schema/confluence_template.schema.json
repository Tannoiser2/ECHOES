{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echoes.local/schema/confluence_template.schema.json",
  "title": "Confluence template collection",
  "x-echoes-def": "confluence_template",
  "x-echoes-kind": "collection",
  "type": "object",
  "required": ["schema_id", "version", "items"],
  "additionalProperties": false,
  "properties": {
    "schema_id": { "const": "confluence_template" },
    "version": { "type": "string" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/confluence_template" }
    }
  },
  "$defs": {
    "confluence_template": {
      "type": "object",
      "required": [
        "id",
        "tension_id",
        "title",
        "questions",
        "propositions",
        "condition_clauses",
        "consequence_pools",
        "ripple"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^CNF_[A-Z0-9_]+$" },
        "tension_id": { "type": "string", "pattern": "^TEN_[A-Z0-9_]+$" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "questions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "text", "eligibility"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "text": { "type": "string", "minLength": 1 },
              "eligibility": {
                "type": "array",
                "items": { "$ref": "destiny.schema.json#/$defs/condition" }
              }
            }
          }
        },
        "propositions": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/proposition" }
        },
        "condition_clauses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "text", "effects"],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "text": { "type": "string", "minLength": 1 },
              "effects": {
                "type": "array",
                "items": { "$ref": "effect.schema.json#/$defs/effect_spec" }
              }
            }
          }
        },
        "consequence_pools": {
          "type": "object",
          "required": ["cost", "failure", "decisive_bonus"],
          "additionalProperties": false,
          "properties": {
            "cost": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "pattern": "^CNS_[A-Z0-9_]+$" }
            },
            "failure": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "pattern": "^CNS_[A-Z0-9_]+$" }
            },
            "decisive_bonus": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "pattern": "^CNS_[A-Z0-9_]+$" }
            }
          }
        },
        "ripple": {
          "type": "object",
          "required": ["targets", "delta"],
          "additionalProperties": false,
          "properties": {
            "targets": {
              "type": "array",
              "minItems": 1,
              "maxItems": 2,
              "items": { "type": "string", "pattern": "^TEN_[A-Z0-9_]+$" }
            },
            "delta": { "type": "integer", "minimum": 1, "maximum": 2 }
          }
        },
        "echo_title_template": { "type": "string" }
      }
    },
    "proposition": {
      "type": "object",
      "required": ["id", "question_id", "text", "eligibility", "success_consequences"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "question_id": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 },
        "eligibility": {
          "type": "array",
          "items": { "$ref": "destiny.schema.json#/$defs/condition" }
        },
        "success_consequences": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^CNS_[A-Z0-9_]+$" }
        },
        "echo_summary": { "type": "string" }
      }
    }
  }
}
