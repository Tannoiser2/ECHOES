{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echoes.local/schema/tension.schema.json",
  "title": "Tension collection",
  "x-echoes-def": "tension",
  "x-echoes-kind": "collection",
  "type": "object",
  "required": [
    "schema_id",
    "version",
    "items"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_id": {
      "const": "tension"
    },
    "version": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/tension"
      }
    }
  },
  "$defs": {
    "tension": {
      "type": "object",
      "required": [
        "id",
        "title",
        "domain",
        "current_value",
        "threshold",
        "visibility",
        "relevant_asset_families",
        "omen_thresholds",
        "possible_questions",
        "triggers",
        "decrease_rules",
        "linked_tensions"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^TEN_[A-Z0-9_]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "type": "string",
          "enum": [
            "TERRITORY",
            "RESOURCE",
            "SURVIVAL",
            "KNOWLEDGE",
            "ANCIENT"
          ]
        },
        "current_value": {
          "type": "integer",
          "minimum": 0
        },
        "threshold": {
          "type": "integer",
          "minimum": 1
        },
        "visibility": {
          "type": "string",
          "enum": [
            "OPEN",
            "VEILED",
            "SECRET"
          ]
        },
        "relevant_asset_families": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "FORCE",
              "AUTHORITY",
              "PEOPLE",
              "KNOWLEDGE",
              "WEALTH",
              "BONDS"
            ]
          }
        },
        "omen_thresholds": {
          "type": "array",
          "description": "Public narrative signals fired when current_value first reaches `at`. Never reveals the number.",
          "items": {
            "type": "object",
            "required": [
              "at",
              "message"
            ],
            "additionalProperties": false,
            "properties": {
              "at": {
                "type": "integer",
                "minimum": 1
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "reveals_value": {
                "type": "boolean",
                "default": false
              }
            }
          }
        },
        "possible_questions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Question ids from the Confluence template that this Tension may raise."
        },
        "triggers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Human-readable notes on what pushes this Tension up."
        },
        "decrease_rules": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Human-readable notes on what pulls this Tension down."
        },
        "linked_tensions": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^TEN_[A-Z0-9_]+$"
          }
        },
        "confluence_template_id": {
          "type": "string",
          "pattern": "^CNF_[A-Z0-9_]+$"
        },
        "description": {
          "type": "string"
        },
        "focus_region_tags": {
          "type": "array",
          "description": "Region tags, most specific first, naming what this Tension is about. The engine picks the Region in the Tension's domain carrying the earliest matching tag and binds it to $region in the authored text, so one question can follow the crisis around the map instead of naming a Region for ever.",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
