{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echoes.local/schema/tension.schema.json",
  "title": "Tension collection",
  "x-echoes-def": "tension",
  "x-echoes-kind": "collection",
  "type": "object",
  "required": [
    "schema_id",
    "version",
    "items"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_id": {
      "const": "tension"
    },
    "version": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/tension"
      }
    }
  },
  "$defs": {
    "tension": {
      "type": "object",
      "required": [
        "id",
        "title",
        "domain",
        "current_value",
        "threshold",
        "visibility",
        "relevant_asset_families",
        "omen_thresholds",
        "possible_questions",
        "triggers",
        "decrease_rules",
        "linked_tensions",
        "theme"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^TEN_[A-Z0-9_]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "type": "string",
          "enum": [
            "TERRITORY",
            "RESOURCE",
            "SURVIVAL",
            "KNOWLEDGE",
            "ANCIENT"
          ]
        },
        "current_value": {
          "type": "integer",
          "minimum": 0
        },
        "threshold": {
          "type": "integer",
          "minimum": 1
        },
        "visibility": {
          "type": "string",
          "enum": [
            "OPEN",
            "VEILED",
            "SECRET"
          ]
        },
        "relevant_asset_families": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "FORCE",
              "AUTHORITY",
              "PEOPLE",
              "KNOWLEDGE",
              "WEALTH",
              "BONDS"
            ]
          }
        },
        "omen_thresholds": {
          "type": "array",
          "description": "Public narrative signals fired when current_value first reaches `at`. Never reveals the number.",
          "items": {
            "type": "object",
            "required": [
              "at",
              "message"
            ],
            "additionalProperties": false,
            "properties": {
              "at": {
                "type": "integer",
                "minimum": 1
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "reveals_value": {
                "type": "boolean",
                "default": false
              }
            }
          }
        },
        "possible_questions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Question ids from the Confluence template that this Tension may raise."
        },
        "physical": {
          "type": "object",
          "description": "La faccia fisica della carta Tensione (D-278): le due liste che si leggono al tavolo quando la carta e' girata. Il proponente sceglie fra le opportunita', il fronte avverso fra i malus.",
          "additionalProperties": false,
          "properties": {
            "opportunities": {
              "type": "array",
              "minItems": 2,
              "description": "Cosa il proponente puo' promettere. Almeno due per Domanda: una sola non e' una scelta.",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "text",
                  "gives"
                ],
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Z0-9_]+$",
                    "description": "Id della voce, unico dentro la carta."
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Come si legge sulla carta, al tavolo."
                  },
                  "gives": {
                    "type": "string",
                    "pattern": "^CNS_[A-Z0-9_]+$",
                    "description": "La Conseguenza che il motore esegue quando questa voce scatta."
                  },
                  "question_id": {
                    "type": "string",
                    "description": "Solo per le opportunita': a quale Domanda della carta risponde."
                  }
                }
              }
            },
            "costs": {
              "type": "array",
              "minItems": 2,
              "description": "Il prezzo che il fronte avverso puo' imporre se la proposta passa pagando (la pedina del prezzo, D-267).",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "text",
                  "takes"
                ],
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Z0-9_]+$",
                    "description": "Id della voce, unico dentro la carta."
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Come si legge sulla carta, al tavolo."
                  },
                  "takes": {
                    "type": "string",
                    "pattern": "^CNS_[A-Z0-9_]+$",
                    "description": "La Conseguenza che il motore esegue quando questa voce scatta."
                  },
                  "question_id": {
                    "type": "string",
                    "description": "Solo per le opportunita': a quale Domanda della carta risponde."
                  }
                }
              }
            },
            "failures": {
              "type": "array",
              "minItems": 2,
              "description": "Lo sfogo che il fronte avverso puo' imporre se la proposta cade.",
              "items": {
                "type": "object",
                "required": [
                  "id",
                  "text",
                  "takes"
                ],
                "additionalProperties": false,
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Z0-9_]+$",
                    "description": "Id della voce, unico dentro la carta."
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Come si legge sulla carta, al tavolo."
                  },
                  "takes": {
                    "type": "string",
                    "pattern": "^CNS_[A-Z0-9_]+$",
                    "description": "La Conseguenza che il motore esegue quando questa voce scatta."
                  },
                  "question_id": {
                    "type": "string",
                    "description": "Solo per le opportunita': a quale Domanda della carta risponde."
                  }
                }
              }
            }
          }
        },
        "triggers": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Human-readable notes on what pushes this Tension up."
        },
        "decrease_rules": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Human-readable notes on what pulls this Tension down."
        },
        "linked_tensions": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^TEN_[A-Z0-9_]+$"
          }
        },
        "confluence_template_id": {
          "type": "string",
          "pattern": "^CNF_[A-Z0-9_]+$"
        },
        "description": {
          "type": "string"
        },
        "focus_region_tags": {
          "type": "array",
          "description": "Region tags, most specific first, naming what this Tension is about. The engine picks the Region in the Tension's domain carrying the earliest matching tag and binds it to $region in the authored text, so one question can follow the crisis around the map instead of naming a Region for ever.",
          "items": {
            "type": "string"
          }
        },
        "opening_line": {
          "type": "string",
          "minLength": 1,
          "description": "The sentence the world says about this question when it is on the table at a Chronicle's opening. A Chronicle that draws its questions composes its opening from these instead of writing one paragraph that would name questions it might not have drawn (D-207)."
        },
        "theme": {
          "type": "string",
          "pattern": "^THM_[A-Z_]+$",
          "description": "Il Tema fisico a cui questa Tensione appartiene sul tavolo. `domain` resta la parola del motore; `theme` e' la traccia di Calore che i giocatori guardano, e le due non coincidono: la Successione e' TERRITORY per il motore e Potere per chi gioca."
        }
      }
    }
  }
}
