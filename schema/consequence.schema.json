{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echoes.local/schema/consequence.schema.json",
  "title": "Consequence collection",
  "x-echoes-def": "consequence",
  "x-echoes-kind": "collection",
  "type": "object",
  "required": [
    "schema_id",
    "version",
    "items"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_id": {
      "const": "consequence"
    },
    "version": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/consequence"
      }
    }
  },
  "$defs": {
    "consequence_category": {
      "type": "string",
      "enum": [
        "CONTROL",
        "PRESENCE",
        "ALLIANCE",
        "HOSTILITY",
        "PACT",
        "DEBT",
        "WAR",
        "MIGRATION",
        "FAMINE",
        "PROSPERITY",
        "DEVASTATION",
        "CORRUPTION",
        "DISCOVERY",
        "SECRET",
        "INFLUENCE",
        "REVOLT",
        "FORTIFICATION",
        "SETTLEMENT",
        "EXPLOITATION",
        "THREAT"
      ]
    },
    "consequence": {
      "type": "object",
      "required": [
        "id",
        "title",
        "category",
        "description",
        "effects"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^CNS_[A-Z0-9_]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "$ref": "#/$defs/consequence_category"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "creates_scar": {
          "type": "boolean",
          "default": false
        },
        "scar": {
          "type": "object",
          "description": "Required when creates_scar is true: the persistent mark this Consequence leaves on the map (§16).",
          "required": [
            "region_id",
            "tag",
            "description"
          ],
          "additionalProperties": false,
          "properties": {
            "region_id": {
              "type": "string"
            },
            "tag": {
              "type": "string"
            },
            "description": {
              "type": "string"
            }
          }
        },
        "effects": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "effect.schema.json#/$defs/effect_spec"
          }
        },
        "requires_entity": {
          "type": "string",
          "pattern": "^ENT_[A-Z0-9_]+$",
          "description": "La casa di cui questa Conseguenza parla (D-213). Col tavolo pescato non tutte le case siedono, e una Conseguenza che spegne il drago non ha senso se il drago non e' al tavolo: dichiarandola, la Conseguenza si salta invece di cadere in un push_error. E' anche il permesso per nominare un id nei suoi Effetti: senza questa riga la guardia lo vieta."
        },
        "requires_entity_tag": {
          "type": "string",
          "minLength": 1,
          "description": "La forma adattiva di requires_entity (D-262): non una casa per nome, ma **chi porta questo segno**. La Conseguenza accade solo se qualcuno al tavolo lo porta addosso — vale il segno vivo, anche guadagnato in partita — e cosi' viaggia su qualunque tavolo pescato. Nei suoi Effetti la stessa casa si nomina con $entity_with:<segno>."
        }
      }
    }
  }
}
