{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echoes.local/schema/chronicle.schema.json",
  "title": "Chronicle definition collection",
  "x-echoes-def": "chronicle",
  "x-echoes-kind": "collection",
  "type": "object",
  "required": [
    "schema_id",
    "version",
    "items"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_id": {
      "const": "chronicle"
    },
    "version": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/chronicle"
      }
    }
  },
  "$defs": {
    "chronicle": {
      "type": "object",
      "required": [
        "id",
        "title",
        "world_id",
        "start_year",
        "acts",
        "rounds_per_act",
        "action_opportunities_per_round",
        "hand_limit",
        "presence_tokens",
        "entities",
        "regions",
        "act_echo_pools",
        "confluence_templates",
        "opening_text"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^CHR_[A-Z0-9_]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "world_id": {
          "type": "string",
          "minLength": 1
        },
        "start_year": {
          "type": "integer"
        },
        "acts": {
          "type": "integer",
          "minimum": 1
        },
        "rounds_per_act": {
          "type": "integer",
          "minimum": 1
        },
        "action_opportunities_per_round": {
          "type": "integer",
          "minimum": 1
        },
        "hand_limit": {
          "type": "integer",
          "minimum": 1
        },
        "presence_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "max_commit_assets": {
          "type": "integer",
          "minimum": 1,
          "default": 3
        },
        "max_condition_commit_assets": {
          "type": "integer",
          "minimum": 1,
          "default": 2
        },
        "condition_qualified_threshold": {
          "type": "integer",
          "minimum": 1,
          "default": 2
        },
        "entities": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "pattern": "^ENT_[A-Z0-9_]+$"
          }
        },
        "regions": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "string",
            "pattern": "^REG_[A-Z0-9_]+$"
          }
        },
        "tensions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^TEN_[A-Z0-9_]+$"
          },
          "description": "The Tensions this Chronicle runs, written out. Authored form. Use tension_pool instead to assemble a Chronicle from the library, which is what makes Chronicle N+1 possible without writing it (D-028)."
        },
        "drift_distribution": {
          "type": "array",
          "minItems": 1,
          "description": "Drift bag. Omit it when using tension_pool: the bag is then dealt evenly across whatever was drawn.",
          "items": {
            "type": "object",
            "required": [
              "tension_id",
              "count"
            ],
            "additionalProperties": false,
            "properties": {
              "tension_id": {
                "type": "string",
                "pattern": "^TEN_[A-Z0-9_]+$"
              },
              "count": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "act_echo_pools": {
          "type": "array",
          "minItems": 1,
          "description": "Dramatic families the Act-end Echo card is drawn from, indexed by act (1-based order). The list is a weighted bag, not a set: repeating a family makes it more likely, and the seeded RNG picks the order in which families are tried. An Act 3 written as [RESOLUTION, RESOLUTION, TURN, RUPTURE] resolves about half the time and can still end mid-crisis (D-030).",
          "items": {
            "type": "object",
            "required": [
              "act",
              "families"
            ],
            "additionalProperties": false,
            "properties": {
              "act": {
                "type": "integer",
                "minimum": 1
              },
              "families": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "enum": [
                    "PRESSURE",
                    "RUPTURE",
                    "TURN",
                    "RESOLUTION"
                  ]
                },
                "description": "Repeats are weights, not duplicates to be cleaned up."
              }
            }
          }
        },
        "confluence_templates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^CNF_[A-Z0-9_]+$"
          }
        },
        "starting_relations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "a",
              "b",
              "level"
            ],
            "additionalProperties": false,
            "properties": {
              "a": {
                "type": "string"
              },
              "b": {
                "type": "string"
              },
              "level": {
                "type": "string",
                "enum": [
                  "ENEMY",
                  "HOSTILE",
                  "NEUTRAL",
                  "ALLY",
                  "BOUND"
                ]
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "global_tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "opening_text": {
          "type": "string",
          "minLength": 1
        },
        "influence_rules": {
          "type": "object",
          "description": "Limits on the INFLUENCE template (§10). Omit the whole object, or any field, to get the original v0.2 behaviour: the presence route works in both directions and there is no per-round cap. See DECISIONS D-021.",
          "additionalProperties": false,
          "properties": {
            "presence_directions": {
              "type": "array",
              "description": "Which directions the free presence route covers. Anything not listed still works, but has to be paid for with a relevant Asset.",
              "items": {
                "type": "string",
                "enum": [
                  "UP",
                  "DOWN"
                ]
              },
              "default": [
                "UP",
                "DOWN"
              ]
            },
            "max_per_entity_per_round": {
              "type": "integer",
              "minimum": 1,
              "description": "How many INFLUENCE actions one Entity may take per round, across all Tensions. Omit for no limit."
            },
            "max_per_tension_per_round": {
              "type": "integer",
              "minimum": 1,
              "description": "How many INFLUENCE actions may touch one Tension per round, by anyone. Bounds how fast the table can move a question against the Drift. Omit for no limit."
            },
            "displacement_on_decrease": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "description": "Pushing a Tension down with INFLUENCE raises one of its linked_tensions by this much. Pressure is displaced, not removed: you do not solve a question, you choose which one to have instead. 0 or absent turns it off (D-029)."
            }
          }
        },
        "control_rules": {
          "type": "object",
          "description": "How holding territory pushes back (D-027). Omit the whole object and control behaves as in v0.2: whatever you take, you keep.",
          "additionalProperties": false,
          "properties": {
            "max_stable_control": {
              "type": "integer",
              "minimum": 0,
              "description": "Regions an Entity can hold without strain. Every Region beyond this raises the Tension of that Region's own domain, once per round."
            },
            "overextension_delta": {
              "type": "integer",
              "minimum": 0,
              "default": 1,
              "description": "How much each Region held beyond the limit raises its domain's Tension."
            },
            "lapse_without_presence": {
              "type": "boolean",
              "default": false,
              "description": "At the start of a continuing Chronicle, a Region held with no presence token in it reverts to nobody. You cannot govern where you are not."
            }
          }
        },
        "tension_pool": {
          "type": "object",
          "description": "Assemble the Chronicle's Tensions from the library instead of listing them. The draw is seeded, so the same seed always deals the same year.",
          "additionalProperties": false,
          "required": [
            "candidates",
            "count"
          ],
          "properties": {
            "candidates": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "pattern": "^TEN_[A-Z0-9_]+$"
              },
              "description": "Tension ids the Chronicle may draw from."
            },
            "count": {
              "type": "integer",
              "minimum": 1,
              "description": "How many to draw."
            },
            "always": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^TEN_[A-Z0-9_]+$"
              },
              "description": "Drawn first, every time: the questions this Chronicle is about by definition."
            }
          }
        }
      }
    }
  }
}
