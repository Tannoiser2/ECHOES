{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://echoes.local/schema/entity.schema.json",
  "title": "Entity collection",
  "x-echoes-def": "entity",
  "x-echoes-kind": "collection",
  "type": "object",
  "required": [
    "schema_id",
    "version",
    "items"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_id": {
      "const": "entity"
    },
    "version": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entity"
      }
    }
  },
  "$defs": {
    "entity": {
      "type": "object",
      "required": [
        "id",
        "name",
        "archetype",
        "need",
        "description",
        "action_values",
        "starting_assets",
        "relations",
        "presence",
        "destiny_id",
        "private_information",
        "tags",
        "active"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^ENT_[A-Z0-9_]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "archetype": {
          "type": "string",
          "enum": [
            "INDIVIDUAL",
            "SOVEREIGN",
            "PEOPLE",
            "FACTION",
            "CREATURE",
            "CULT"
          ]
        },
        "need": {
          "type": "string",
          "enum": [
            "POWER",
            "SURVIVAL",
            "FREEDOM",
            "KNOWLEDGE",
            "WEALTH",
            "REVENGE",
            "PROTECTION",
            "FAITH"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "action_values": {
          "type": "object",
          "description": "Per-template flavour weighting used by the CLI default policy. Not a modifier on resolution math in v0.2.",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          },
          "propertyNames": {
            "enum": [
              "ACQUIRE",
              "MOVE",
              "INFLUENCE",
              "FORGE",
              "SCHEME",
              "CLAIM"
            ]
          }
        },
        "starting_assets": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^AST_[A-Z0-9_]+$"
          }
        },
        "relations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "with",
              "level"
            ],
            "additionalProperties": false,
            "properties": {
              "with": {
                "type": "string",
                "pattern": "^ENT_[A-Z0-9_]+$"
              },
              "level": {
                "type": "string",
                "enum": [
                  "ENEMY",
                  "HOSTILE",
                  "NEUTRAL",
                  "ALLY",
                  "BOUND"
                ]
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "PACT",
                    "DEBT",
                    "PROMISE",
                    "VENDETTA",
                    "KINSHIP"
                  ]
                }
              }
            }
          }
        },
        "presence": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "string",
            "pattern": "^REG_[A-Z0-9_]+$"
          }
        },
        "destiny_id": {
          "type": "string",
          "pattern": "^DST_[A-Z0-9_]+$"
        },
        "private_information": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "active": {
          "type": "boolean"
        },
        "art_prompt_key": {
          "type": "string"
        },
        "marker_id": {
          "type": "string"
        },
        "persistence": {
          "type": "string",
          "enum": [
            "MORTAL",
            "COLLECTIVE",
            "ETERNAL"
          ],
          "description": "Chi attraversa un salto di secoli. MORTAL: una persona, e dopo un salto lungo al suo posto c'e un successore. COLLECTIVE: un popolo, che cambia senza finire. ETERNAL: qualcosa che il tempo non tocca. L'id resta - e il seggio, la casa, la cosa sotto la montagna - e a cambiare e il nome (D-045)."
        },
        "successors": {
          "type": "array",
          "description": "I nomi che questo seggio prende dopo un salto lungo, in ordine. Serve solo a MORTAL.",
          "items": {
            "type": "object",
            "required": [
              "name"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              }
            }
          }
        },
        "destiny_pool": {
          "type": "array",
          "description": "Cosa questo seggio puo volere nelle Chronicle successive. Si pesca da qui solo quando il Destino precedente e stato raggiunto: chi ha fallito riprova, chi ha ottenuto vuole altro (D-045).",
          "items": {
            "type": "string",
            "pattern": "^DST_[A-Z0-9_]+$"
          }
        },
        "name_grammar": {
          "type": "object",
          "description": "Come questa casa fa i nomi quando la lista dei successori scritti a mano finisce. Serve perche una saga lunga non ha un numero di generazioni deciso in anticipo: dodici nomi bastano per dodici salti e poi ricominciano, ed e esattamente quello che un audit di dieci Chronicle ha trovato (D-046).",
          "required": [
            "pattern",
            "given"
          ],
          "additionalProperties": false,
          "properties": {
            "pattern": {
              "type": "string",
              "description": "Le fessure disponibili: {title} {given} {ordinal} {epithet}."
            },
            "given": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "titles": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "epithets": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
